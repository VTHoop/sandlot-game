# ── Client-side (Vite) ────────────────────────────────────────────────────────
# Convex — deployment URL written to .env.local by `npx convex dev`
VITE_CONVEX_URL=

# Clerk — publishable key from the Clerk Dashboard → API Keys (starts with pk_test_ or pk_live_)
VITE_CLERK_PUBLISHABLE_KEY=

# ── Convex server-side env vars (set via `npx convex env set <KEY> <VALUE>`) ──
# Clerk Frontend API URL — Clerk Dashboard → API Keys → "Frontend API" value
# Required by convex/auth.config.ts so ctx.auth works in server functions.
# Also create a JWT Template named "convex" in the Clerk Dashboard.
CLERK_ISSUER_URL=

# Dev-only fixture seed (SAN-54, split in SAN-61) — opt-in gate for both of
# convex/seed.ts's mutations. Fail-closed: they refuse to run unless this is
# exactly "true", so leaving it unset (the default on any new deployment) blocks
# them. NEVER set in production.
# Enable locally with: npx convex env set SANDLOT_DEV_SEED true
# Stand the league up with: npx convex run seed:bootstrapDevLeague
# Then add games with:     npx convex run seed:mintDevGame '{"homeTeam":"…","awayTeam":"…"}'
# Play as yourself with:   npx convex run seed:assignClubToUser '{"team":"…","clerkSubject":"user_…"}'
#   (sign in once first — the subject must already have a users row)
SANDLOT_DEV_SEED=
