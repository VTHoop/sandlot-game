{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash .claude/hooks/tdd-guard.sh"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "software-factory": {
      "source": {
        "source": "github",
        "repo": "VTHoop/software-factory",
        "ref": "v0.2.0"
      }
    }
  },
  "enabledPlugins": {
    "software-factory@software-factory": true
  }
}
