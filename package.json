{
  "name": "sandlot-game",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@11.28.11",
  "scripts": {
    "dev": "vite",
    "dev:game": "tsx scripts/dev-game.ts",
    "ingest:mlb": "tsx scripts/ingest-mlb.ts",
    "normalize:mlb": "tsx scripts/normalize-mlb.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc -b && tsc -p convex/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e:smoke": "playwright test --project=smoke",
    "codescene:check": "tsx --env-file-if-exists=.env.local scripts/check-code-health.ts",
    "emit-grid": "tsx packages/engine/bin/emit-grid.ts",
    "derive-balance": "tsx packages/engine/bin/derive-balance.ts"
  },
  "dependencies": {
    "@clerk/react": "^6.18.5",
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/graduate": "^5.3.0",
    "@sandlot/engine": "workspace:*",
    "convex": "^1.49.0",
    "motion": "^12.43.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router": "^7.18.5",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.3",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^25.9.9",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@types/web-push": "^3.6.4",
    "@vitejs/plugin-react": "^6.2.1",
    "@vitest/coverage-v8": "^4.1.12",
    "convex-test": "^0.0.62",
    "jsdom": "^26.1.0",
    "lefthook": "^2.2.2",
    "tailwindcss": "^4.3.4",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.12",
    "workbox-precaching": "^7.4.1"
  }
}
